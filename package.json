{
    "name": "@maniumek/suwfrontkit",
    "version": "0.1.0",
    "description": "Catppuccin Mocha design tokens, Tailwind 4 theme, Inter Variable and React components for desktop web apps",
    "license": "MIT",
    "author": "Manomenu",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Manomenu/suwfrontkit.git"
    },
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./diagram": {
            "types": "./dist/diagram/index.d.ts",
            "default": "./dist/diagram/index.js"
        },
        "./theme.css": "./dist/theme/theme.css",
        "./diagram.css": "./dist/diagram/diagram.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "packageManager": "pnpm@11.24.0",
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/theme && cp src/theme/theme.css src/theme/palette.css dist/theme/ && cp src/diagram/diagram.css dist/diagram/",
        "storybook": "storybook dev -p 6006 --no-open",
        "build-storybook": "storybook build --quiet -o storybook-static",
        "changeset": "changeset",
        "release": "pnpm run build && changeset publish",
        "prepack": "pnpm run build"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "diff": "^9.0.0",
        "radix-ui": "^1.8.1",
        "tailwind-merge": "^3.7.0"
    },
    "peerDependencies": {
        "@xyflow/react": "^13.0.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.0"
    },
    "peerDependenciesMeta": {
        "@xyflow/react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@axe-core/playwright": "4.14.0",
        "@catppuccin/palette": "1.8.0",
        "@changesets/cli": "3.0.3",
        "@eslint/js": "^10.0.1",
        "@maniumek/suwgate": "0.1.0",
        "@playwright/test": "1.65.1",
        "@storybook/addon-a11y": "10.6.7",
        "@storybook/addon-vitest": "10.6.7",
        "@storybook/react-vite": "10.6.7",
        "@tailwindcss/vite": "4.3.5",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/browser": "5.1.1",
        "@vitest/browser-playwright": "5.1.1",
        "@xyflow/react": "13.0.2",
        "eslint": "^10.15.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.4.4",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^31.0.1",
        "knip": "^6.46.1",
        "playwright": "1.65.1",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "publint": "0.3.25",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "storybook": "10.6.7",
        "tailwindcss": "4.3.5",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.73.0",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
